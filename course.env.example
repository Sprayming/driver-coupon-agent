# 模型配置示例：复制本文件为 course.env 并填入自己的 Key
# 默认按硅基流动 OpenAI-compatible 接口预填，其他 OpenAI 兼容服务（DeepSeek 等）亦可

AGENT_OPENAI_API_KEY=sk-your-key-here
AGENT_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
AGENT_OPENAI_MODEL=Qwen/Qwen3-8B
AGENT_CLASSIFIER_MODEL=Qwen/Qwen3-8B
# 候补模型（逗号分隔，主模型 429/5xx/超时时按顺序自动切换）
# 例：AGENT_OPENAI_MODELS=Qwen/Qwen2.5-7B-Instruct,deepseek-ai/DeepSeek-V3
AGENT_OPENAI_MODELS=
AGENT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
AGENT_RAG_RERANK_ENABLED=true
AGENT_RAG_RERANK_MODEL=Qwen/Qwen3-Reranker-8B
AGENT_RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1
AGENT_RAG_CACHE_ENABLED=true
AGENT_KNOWLEDGE_LIFECYCLE_ENABLED=true
AGENT_RBAC_ENABLED=true

# 管理后台（方案 A：内部员工账号体系）
# 机器调用（CI/脚本）仍可用该令牌；人工操作必须登录 /auth/login。
AGENT_ADMIN_TOKEN=dev-admin-token
AGENT_AUTH_SESSION_TTL_HOURS=8
# 首次启动播种的演示账号密码（生产请改成强密码或关闭播种）
AGENT_AUTH_SEED_PASSWORD=demo123456

# 意图识别供应商：rule=纯规则（默认，零额外延迟）；hybrid=规则优先，低置信时语义兜底
# 语义兜底有超时上限，超时/失败自动回退规则，不会阻断聊天
AGENT_INTENT_PROVIDER=rule
AGENT_INTENT_LLM_TIMEOUT_SECONDS=1.5
# 登录页是否允许自助注册（注册固定为只读 viewer，提权由 publisher 在用户管理里做）
AGENT_ALLOW_SELF_REGISTER=true
